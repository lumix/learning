<!DOCTYPE html>
<html>
<head>
  <title>Random Number Generator</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .container {
      background: white;
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      text-align: center;
      max-width: 400px;
      width: 90%;
    }

    h1 {
      color: #333;
      margin-bottom: 30px;
      font-size: 2.5em;
      font-weight: 300;
    }

    .number-display {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      font-size: 4em;
      font-weight: bold;
      border-radius: 15px;
      padding: 30px;
      margin: 30px 0;
      min-height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    }

    .generate-btn {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: none;
      padding: 15px 40px;
      font-size: 1.2em;
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
      text-decoration: none;
      display: inline-block;
    }

    .generate-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 7px 20px rgba(102, 126, 234, 0.6);
    }

    .generate-btn:active {
      transform: translateY(0);
    }

    .description {
      color: #666;
      margin-bottom: 30px;
      font-size: 1.1em;
    }

    .range-info {
      color: #888;
      font-size: 0.9em;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>🎲 Random Number Generator</h1>
    <p class="description">Click the button below to generate a random number between 1 and 20!</p>
    
    <div class="number-display">
      <% if @random_number %>
        <%= @random_number %>
      <% else %>
        ?
      <% end %>
    </div>

    <%= link_to "Generate Random Number", random_number_generate_path, method: :post, class: "generate-btn" %>
    
    <p class="range-info">Range: 1 - 20</p>
  </div>
</body>
</html>